{
  // Indique à l'extension Dart/Flutter d'utiliser le SDK géré par FVM
  // (symlink .fvm/flutter_sdk -> version pinnée dans .fvmrc, ici 3.44.2)
  "dart.flutterSdkPath": ".fvm/flutter_sdk",

  // Évite que VS Code indexe / surveille le dossier du SDK FVM
  "search.exclude": {
    "**/.fvm": true
  },
  "files.watcherExclude": {
    "**/.fvm/**": true
  }
}
